{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "api": {
    "tag": "api",
    "listen": "10.42.0.10:10085",
    "services": ["HandlerService", "RoutingService", "StatsService"]
  },
  "stats": {},
  "policy": {
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "inbounds": [
    {
      "tag": "api-in",
      "listen": "10.42.0.10",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": { "address": "10.42.0.10" }
    }
  ],
  "outbounds": [
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api-in"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "blocked"
      }
    ]
  }
}
