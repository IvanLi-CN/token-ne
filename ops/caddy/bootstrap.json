{
  "admin": {
    "listen": "unix//run/caddy/admin.sock"
  },
  "apps": {
    "http": {
      "servers": {
        "token-ne": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "@id": "token-ne-deny-internal",
              "match": [
                {
                  "path": [
                    "/internal",
                    "/internal/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "not found"
                }
              ],
              "terminal": true
            },
            {
              "@id": "token-ne-v1",
              "match": [
                {
                  "path": [
                    "/v1/*"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 503,
                  "@id": "token-ne-v1-proxy"
                }
              ],
              "terminal": true
            },
            {
              "@id": "token-ne-api",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "api:8080"
                    }
                  ]
                }
              ],
              "terminal": true,
              "match": [
                {
                  "path": [
                    "/api/*",
                    "/healthz",
                    "/readyz"
                  ]
                }
              ]
            },
            {
              "@id": "token-ne-spa",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "api:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      },
      "grace_period": "0s"
    }
  }
}
