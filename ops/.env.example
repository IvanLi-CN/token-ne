COMPOSE_PROJECT_NAME=token-ne
POSTGRES_PASSWORD=change-me
PUBLIC_ORIGIN=http://127.0.0.1:8080
PUBLIC_DOMAIN=
CADDY_HTTP_PORT=8080
CADDY_TLS_MODE=off
METRICS_PORT=9090
METRICS_TOKEN=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_CA_FILE=
AUTH_LOCAL_LOGIN_ENABLED=true
AUTH_SESSION_TTL_HOURS=720
MASTER_KEY=
CORE_CONTROL_TOKEN=change-me
CORE_CONFIG_SIGNING_KEY=
CORE_CONFIG_SIGNATURE_MODE=warn
CORE_CACHE_KEY=
CORE_ALLOW_PRIVATE_UPSTREAMS=false
STREAM_USAGE_INJECTION=true
# 第二期管理契约的唯一部署开关；默认 false，只在 Web 客户端已发布严格 capabilities_revision 载荷后启用。
SECOND_PHASE_MODEL_MANAGEMENT=false
CORE_STATE_HOST_DIR=/var/lib/token-ne/cores
CORE_STATE_INIT_IMAGE=busybox:1.37
CORE_IMAGE_REPOSITORY=ghcr.io/ivanli-cn/token-ne-core
SESSION_SECRET=change-me
