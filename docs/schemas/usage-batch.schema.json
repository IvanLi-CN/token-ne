{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-ne.local/schemas/usage-batch.schema.json",
  "title": "token-ne usage batch",
  "type": "object",
  "required": ["protocol_version", "message_id", "sent_at", "type", "payload"],
  "additionalProperties": true,
  "properties": {
    "protocol_version": { "const": 1 },
    "message_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sent_at": { "type": "string", "format": "date-time" },
    "type": { "const": "usage_batch" },
    "payload": {
      "type": "object",
      "required": ["batch_id", "core_instance_id", "events"],
      "additionalProperties": true,
      "properties": {
        "batch_id": { "type": "string", "format": "uuid" },
        "core_instance_id": { "type": "string", "format": "uuid" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/event" }
        }
      }
    }
  },
  "$defs": {
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "nullableDuration": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 86400000
    },
    "nullableUuid": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "request_id",
        "occurred_at",
        "core_version",
        "core_instance",
        "endpoint",
        "stream",
        "outcome",
        "attempt_count"
      ],
      "additionalProperties": true,
      "properties": {
        "event_id": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "core_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "core_instance": { "type": "string", "format": "uuid" },
        "downstream_key_id": { "$ref": "#/$defs/nullableUuid" },
        "upstream_id": { "$ref": "#/$defs/nullableUuid" },
        "egress_mode": {
          "type": "string",
          "enum": ["direct", "proxy"],
          "description": "Optional for phase-one and unrecorded events. proxy requires a non-null egress_proxy_id; direct requires null or absence."
        },
        "egress_proxy_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "endpoint": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requested_model": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "resolved_model": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256,
          "description": "Optional for phase-one and local-error events. For a second-phase request the producer sends the global model ID resolved from its own applied config snapshot. Ingest must not reject an unknown value: membership is checked against the producer's snapshot, and the control plane falls back to requested_model for cost attribution when the value no longer matches the current config."
        },
        "upstream_model": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "stream": { "type": "boolean" },
        "http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "status_rewritten_from": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "outcome": {
          "enum": [
            "success",
            "upstream_error",
            "local_error",
            "client_disconnected",
            "aborted"
          ]
        },
        "error_class": {
          "type": ["string", "null"],
          "enum": [
            "connect_error",
            "dns_error",
            "tls_error",
            "first_byte_timeout",
            "idle_timeout",
            "upstream_http_error",
            "upstream_stream_error",
            "local_validation_error",
            "client_disconnected",
            "aborted",
            "unknown",
            null
          ]
        },
        "error_code": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "error_message": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "attempt_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "request_bytes": { "$ref": "#/$defs/nullableInteger" },
        "response_bytes": { "$ref": "#/$defs/nullableInteger" },
        "input_tokens": { "$ref": "#/$defs/nullableInteger" },
        "cached_input_tokens": { "$ref": "#/$defs/nullableInteger" },
        "cache_write_tokens": { "$ref": "#/$defs/nullableInteger" },
        "audio_input_tokens": { "$ref": "#/$defs/nullableInteger" },
        "audio_output_tokens": { "$ref": "#/$defs/nullableInteger" },
        "output_tokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoning_tokens": { "$ref": "#/$defs/nullableInteger" },
        "total_tokens": { "$ref": "#/$defs/nullableInteger" },
        "ttft_ms": { "$ref": "#/$defs/nullableDuration" },
        "upstream_ttfb_ms": { "$ref": "#/$defs/nullableDuration" },
        "duration_ms": { "$ref": "#/$defs/nullableDuration" },
        "upstream_duration_ms": { "$ref": "#/$defs/nullableDuration" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "stream": { "const": false } },
            "required": ["stream"]
          },
          "then": {
            "properties": { "ttft_ms": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "not": { "const": "local_error" } } },
            "required": ["outcome"]
          },
          "then": {
            "properties": { "attempt_count": { "minimum": 1 } }
          }
        },
        {
          "if": {
            "properties": { "egress_mode": { "const": "proxy" } },
            "required": ["egress_mode"]
          },
          "then": {
            "required": ["egress_proxy_id"],
            "properties": { "egress_proxy_id": { "type": "string" } }
          }
        },
        {
          "if": {
            "properties": { "egress_mode": { "const": "direct" } },
            "required": ["egress_mode"]
          },
          "then": {
            "properties": { "egress_proxy_id": { "type": "null" } }
          }
        },
        {
          "if": {
            "required": ["egress_proxy_id"],
            "properties": { "egress_proxy_id": { "type": "string" } }
          },
          "then": {
            "required": ["egress_mode"],
            "properties": { "egress_mode": { "const": "proxy" } }
          }
        },
        {
          "if": {
            "required": ["outcome", "attempt_count"],
            "properties": {
              "outcome": { "const": "local_error" },
              "attempt_count": { "const": 0 }
            }
          },
          "then": {
            "not": {
              "anyOf": [{ "required": ["egress_mode"] }, { "required": ["egress_proxy_id"] }]
            }
          }
        }
      ]
    }
  }
}
