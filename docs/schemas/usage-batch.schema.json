{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-ne.local/schemas/usage-batch.schema.json",
  "title": "token-ne usage batch",
  "type": "object",
  "required": ["protocol_version", "message_id", "sent_at", "type", "payload"],
  "additionalProperties": true,
  "properties": {
    "protocol_version": { "const": 1 },
    "message_id": { "type": "string", "format": "uuid" },
    "sent_at": { "type": "string", "format": "date-time" },
    "type": { "const": "usage_batch" },
    "payload": {
      "type": "object",
      "required": ["batch_id", "core_instance_id", "events"],
      "additionalProperties": true,
      "properties": {
        "batch_id": { "type": "string", "format": "uuid" },
        "core_instance_id": { "type": "string", "format": "uuid" },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/event" }
        }
      }
    }
  },
  "$defs": {
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullableUuid": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "request_id",
        "occurred_at",
        "core_version",
        "core_instance",
        "endpoint",
        "stream",
        "outcome",
        "attempt_count"
      ],
      "additionalProperties": true,
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "core_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "core_instance": { "type": "string", "format": "uuid" },
        "downstream_key_id": { "$ref": "#/$defs/nullableUuid" },
        "upstream_id": { "$ref": "#/$defs/nullableUuid" },
        "endpoint": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requested_model": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "upstream_model": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "stream": { "type": "boolean" },
        "http_status": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "status_rewritten_from": {
          "type": ["integer", "null"],
          "minimum": 100,
          "maximum": 599
        },
        "outcome": {
          "enum": [
            "success",
            "upstream_error",
            "local_error",
            "client_disconnected",
            "aborted"
          ]
        },
        "error_class": {
          "type": ["string", "null"],
          "enum": [
            "connect_error",
            "dns_error",
            "tls_error",
            "first_byte_timeout",
            "idle_timeout",
            "upstream_http_error",
            "upstream_stream_error",
            "local_validation_error",
            "client_disconnected",
            "aborted",
            "unknown",
            null
          ]
        },
        "error_code": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "error_message": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "attempt_count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "request_bytes": { "$ref": "#/$defs/nullableInteger" },
        "response_bytes": { "$ref": "#/$defs/nullableInteger" },
        "input_tokens": { "$ref": "#/$defs/nullableInteger" },
        "cached_input_tokens": { "$ref": "#/$defs/nullableInteger" },
        "output_tokens": { "$ref": "#/$defs/nullableInteger" },
        "reasoning_tokens": { "$ref": "#/$defs/nullableInteger" },
        "total_tokens": { "$ref": "#/$defs/nullableInteger" },
        "ttft_ms": { "$ref": "#/$defs/nullableInteger" },
        "upstream_ttfb_ms": { "$ref": "#/$defs/nullableInteger" },
        "duration_ms": { "$ref": "#/$defs/nullableInteger" },
        "upstream_duration_ms": { "$ref": "#/$defs/nullableInteger" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "stream": { "const": false } },
            "required": ["stream"]
          },
          "then": {
            "properties": { "ttft_ms": { "type": "null" } }
          }
        }
      ]
    }
  }
}
