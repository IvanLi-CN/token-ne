{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-ne.local/schemas/config.schema.json",
  "title": "token-ne core configuration snapshot",
  "type": "object",
  "required": [
    "protocol_version",
    "config_schema_version",
    "instance_id",
    "revision",
    "issued_at",
    "features",
    "downstream_keys",
    "models",
    "upstreams",
    "upstream_models",
    "retry",
    "status_rewrite",
    "usage",
    "limits"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "required": ["model_routes"], "properties": { "model_routes": { "minItems": 1 } } },
      "then": { "properties": { "features": { "required": ["model_name_routing"], "properties": { "model_name_routing": { "const": true } } } } }
    },
    {
      "if": { "required": ["upstream_policies"], "properties": { "upstream_policies": { "minItems": 1 } } },
      "then": { "properties": { "features": { "required": ["upstream_model_policy"], "properties": { "upstream_model_policy": { "const": true } } } } }
    },
    {
      "if": { "required": ["egress_proxies"], "properties": { "egress_proxies": { "minItems": 1 } } },
      "then": { "properties": { "features": { "required": ["egress_proxy"], "properties": { "egress_proxy": { "const": true } } } } }
    },
    {
      "if": {
        "required": ["upstreams"],
        "properties": {
          "upstreams": {
            "contains": {
              "required": ["egress_proxy_id"],
              "properties": { "egress_proxy_id": { "type": "string" } }
            }
          }
        }
      },
      "then": { "properties": { "features": { "required": ["egress_proxy"], "properties": { "egress_proxy": { "const": true } } } } }
    },
    {
      "if": {
        "not": {
          "required": ["features"],
          "properties": {
            "features": {
              "required": ["egress_proxy"],
              "properties": { "egress_proxy": { "const": true } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "egress_proxies": { "maxItems": 0 },
          "upstreams": {
            "items": {
              "properties": { "egress_proxy_id": { "type": "null" } }
            }
          }
        }
      }
    }
  ],
  "$comment": "Publisher and core semantic validation rejects duplicate upstream_policies entries by upstream_id, duplicate egress_proxies ids, non-canonical UUIDs (format is annotation-only here), dangling upstream egress_proxy_id references, dangling model/upstream references, invalid full-string Glob patterns, and unknown modelRoute/upstreamPolicy/egressProxy fields. Only * and ? are wildcard operators; brackets, braces, backslash, and control characters are invalid. When model_name_routing, upstream_model_policy, or egress_proxy is absent or false, its corresponding fields must be absent or empty/null. Route, policy, and egress proxy object schemas reject unknown fields because silently ignoring a misspelled routing or egress-security field is unsafe. Third-party proxy protocol, server address and credentials never appear in the core snapshot.",
  "properties": {
    "protocol_version": { "const": 1 },
    "config_schema_version": { "type": "integer", "minimum": 1 },
    "instance_id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "features": {
      "type": "object",
      "required": [
        "chat_completions",
        "responses",
        "embeddings",
        "stream_usage_injection",
        "status_rewrite"
      ],
      "properties": {
        "chat_completions": { "type": "boolean" },
        "responses": { "type": "boolean" },
        "embeddings": { "type": "boolean" },
        "stream_usage_injection": { "type": "boolean" },
        "status_rewrite": { "type": "boolean" },
        "model_name_routing": { "type": "boolean" },
        "upstream_model_policy": { "type": "boolean" },
        "egress_proxy": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "downstream_keys": {
      "type": "array",
      "items": { "$ref": "#/$defs/downstreamKey" }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    },
    "upstreams": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstream" }
    },
    "egress_proxies": {
      "type": "array",
      "items": { "$ref": "#/$defs/egressProxy" }
    },
    "upstream_models": {
      "type": "array",
      "items": { "$ref": "#/$defs/upstreamModel" }
    },
    "model_routes": {
      "type": "array",
      "items": { "$ref": "#/$defs/modelRoute" }
    },
    "upstream_policies": {
      "type": "array",
      "$comment": "Both publisher and core must additionally reject duplicate upstream_id values, even when the policy objects differ; JSON Schema uniqueItems cannot enforce key uniqueness.",
      "items": { "$ref": "#/$defs/upstreamPolicy" }
    },
    "retry": { "$ref": "#/$defs/retry" },
    "status_rewrite": { "$ref": "#/$defs/statusRewrite" },
    "usage": { "$ref": "#/$defs/usage" },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "nullableUuid": { "type": ["string", "null"], "format": "uuid" },
    "downstreamKey": {
      "type": "object",
      "required": ["id", "name", "sha256", "enabled", "allowed_models", "max_inflight"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "enabled": { "type": "boolean" },
        "allowed_models": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 }
        },
        "max_inflight": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "additionalProperties": true
    },
    "billing": {
      "type": "object",
      "required": [
        "input_usd_per_mtok",
        "cached_input_usd_per_mtok",
        "output_usd_per_mtok"
      ],
      "properties": {
        "input_usd_per_mtok": { "type": ["number", "null"], "minimum": 0 },
        "cached_input_usd_per_mtok": { "type": ["number", "null"], "minimum": 0 },
        "output_usd_per_mtok": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "required": ["model_id", "enabled", "billing"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "enabled": { "type": "boolean" },
        "default_upstream_model": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "shutdown_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "created_at": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 253402300799
        },
        "billing": { "$ref": "#/$defs/billing" }
      },
      "additionalProperties": true
    },
    "upstream": {
      "type": "object",
      "required": [
        "id",
        "name",
        "base_url",
        "auth_style",
        "api_key",
        "enabled"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "base_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "auth_style": { "enum": ["bearer", "api_key"] },
        "api_key": { "type": "string", "minLength": 1 },
        "connect_timeout_ms": { "type": "integer", "minimum": 100 },
        "first_byte_timeout_ms": { "type": "integer", "minimum": 100 },
        "idle_timeout_ms": { "type": "integer", "minimum": 100 },
        "egress_proxy_id": { "$ref": "#/$defs/nullableUuid" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "egressProxy": {
      "type": "object",
      "required": ["id", "endpoint", "enabled"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "maxLength": 256,
          "pattern": "^socks5h://(?:(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)|\\[(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        },
        "enabled": {
          "type": "boolean",
          "description": "Effective routing eligibility. True only when the control plane has enabled the profile and its runtime state is ready; degraded or disabled profiles are false."
        }
      },
      "additionalProperties": false
    },
    "upstreamModel": {
      "type": "object",
      "required": ["upstream_id", "model_id", "enabled", "priority", "weight"],
      "properties": {
        "upstream_id": { "type": "string", "format": "uuid" },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "upstream_model_name": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "weight": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "additionalProperties": true
    },
    "modelRoute": {
      "type": "object",
      "required": ["id", "pattern", "match_type", "target_model_id", "priority", "enabled"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 256 },
        "match_type": { "enum": ["exact", "glob"] },
        "target_model_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "upstream_id": { "type": ["string", "null"], "format": "uuid" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "enabled": { "type": "boolean" },
        "description": { "type": ["string", "null"], "maxLength": 1024 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "match_type": { "const": "glob" } }, "required": ["match_type"] },
          "then": { "properties": { "pattern": { "$ref": "#/$defs/globPattern" } } }
        }
      ]
    },
    "globPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\[\\]{}\\\\\\x00-\\x1f\\x7f]+$"
    },
    "upstreamPolicy": {
      "type": "object",
      "required": ["upstream_id", "default_action", "allow_patterns", "deny_patterns"],
      "properties": {
        "upstream_id": { "type": "string", "format": "uuid" },
        "default_action": { "enum": ["allow", "deny"] },
        "allow_patterns": { "type": "array", "items": { "$ref": "#/$defs/globPattern" }, "uniqueItems": true },
        "deny_patterns": { "type": "array", "items": { "$ref": "#/$defs/globPattern" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "required": [
        "max_attempts",
        "retry_statuses",
        "backoff_ms",
        "respect_retry_after",
        "retry_after_max_ms"
      ],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "retry_statuses": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "uniqueItems": true
        },
        "backoff_ms": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 60000 }
        },
        "respect_retry_after": { "type": "boolean" },
        "retry_after_max_ms": { "type": "integer", "minimum": 0, "maximum": 60000 }
      },
      "additionalProperties": true
    },
    "statusRewrite": {
      "type": "object",
      "required": [
        "schema_version",
        "policy_source",
        "policy_hash",
        "enabled",
        "rules",
        "never_rewrite"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "policy_source": { "enum": ["file", "db", "default"] },
        "policy_hash": { "type": "string" },
        "enabled": { "type": "boolean" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/statusRewriteRule" }
        },
        "never_rewrite": {
          "type": "object",
          "required": ["statuses", "after_commit"],
          "properties": {
            "statuses": {
              "type": "array",
              "items": { "type": "integer", "minimum": 400, "maximum": 599 },
              "allOf": [
                { "contains": { "const": 400 } },
                { "contains": { "const": 401 } },
                { "contains": { "const": 403 } },
                { "contains": { "const": 404 } },
                { "contains": { "const": 409 } },
                { "contains": { "const": 422 } }
              ]
            },
            "after_commit": { "const": true }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "statusRewriteRule": {
      "type": "object",
      "required": ["id", "match", "response"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "match": {
          "type": "object",
          "required": ["committed", "retry_exhausted"],
          "properties": {
            "upstream_status": {
              "type": "array",
              "items": { "type": "integer", "minimum": 400, "maximum": 599 }
            },
            "error_class": {
              "type": "array",
              "items": {
                "enum": [
                  "connect_error",
                  "dns_error",
                  "tls_error",
                  "first_byte_timeout",
                  "idle_timeout",
                  "upstream_http_error",
                  "upstream_stream_error",
                  "local_validation_error",
                  "client_disconnected",
                  "aborted",
                  "unknown"
                ]
              }
            },
            "committed": { "const": false },
            "retry_exhausted": { "const": true }
          },
          "anyOf": [
            { "required": ["upstream_status"] },
            { "required": ["error_class"] }
          ],
          "additionalProperties": true
        },
        "response": {
          "type": "object",
          "required": ["status", "code", "retryable"],
          "properties": {
            "status": { "type": "integer", "minimum": 500, "maximum": 599 },
            "code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "message": { "type": "string", "maxLength": 1024 },
            "retryable": { "type": "boolean" },
            "preserve_retry_after": { "type": "boolean" },
            "default_retry_after_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "usage": {
      "type": "object",
      "required": ["endpoint", "token", "batch_max_events", "queue_max_events", "spool"],
      "properties": {
        "endpoint": { "type": "string", "format": "uri" },
        "token": { "type": "string", "minLength": 1 },
        "batch_max_events": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "queue_max_events": { "type": "integer", "minimum": 1 },
        "spool": {
          "type": "object",
          "required": [
            "dir",
            "max_bytes",
            "min_free_bytes",
            "max_age_hours",
            "segment_bytes",
            "fsync_interval_ms"
          ],
          "properties": {
            "dir": { "type": "string" },
            "max_bytes": { "type": "integer", "minimum": 1048576 },
            "min_free_bytes": { "type": "integer", "minimum": 0 },
            "max_age_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
            "segment_bytes": { "type": "integer", "minimum": 1048576 },
            "fsync_interval_ms": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "required": [
        "max_request_body_bytes",
        "max_inflight",
        "per_key_max_inflight",
        "request_max_duration_ms",
        "shutdown_grace_ms",
        "precommit_buffer_bytes",
        "nonstream_inspect_bytes"
      ],
      "properties": {
        "max_request_body_bytes": { "type": "integer", "minimum": 1 },
        "max_inflight": { "type": "integer", "minimum": 1 },
        "per_key_max_inflight": { "type": "integer", "minimum": 1 },
        "request_max_duration_ms": { "type": "integer", "minimum": 1000 },
        "shutdown_grace_ms": { "type": "integer", "minimum": 1000 },
        "precommit_buffer_bytes": { "type": "integer", "minimum": 1 },
        "nonstream_inspect_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  }
}
