{
  "name": "token-ne-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 60080",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 60081",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "biome check src build vite.config.ts",
    "format": "biome format --write src build vite.config.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:demo": "tsc -b && vite build --mode demo"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.108.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "28.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
